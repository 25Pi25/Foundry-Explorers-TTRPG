<section class="tab standard-form {{tabs.items.cssClass}}" data-group="primary" data-tab="items">
  {{#if items}}
  <div class="item-list scrollable">
    <div class="item-row">
      <p>Name</p>
      <p>Description</p>
      <p>Category</p>
      <p>Price</p>
      <div></div>
    </div>
    {{#each items as |item|}}
    {{#with ..}}
    <div class="item-row">
      <div class="item-main">
        <img class="item-image" src="{{item.img}}" width="50" height="50">
        <span>{{item.name}}</span>
      </div>
      <p>{{item.system.description}}</p>
      <p>{{localize (lookup itemCategories item.system.category)}}</p>
      <p>{{#if item.system.price}}{{item.system.price}}P{{/if}}</p>
      <button type="button" data-action="removeItem" data-id="{{item.id}}" class="icon fa-solid fa-trash"></button>
    </div>
    {{/with}}
    {{/each}}
  </div>
  {{else}}
  <div class="item-help">
    Drag an item onto the character sheet to import it!
  </div>
  {{/if}}
</section>