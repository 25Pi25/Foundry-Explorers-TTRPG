<div class="colored-boxes character-header">
  <div class="center">
    <img src="{{document.img}}" title="{{document.name}}" style="cursor: pointer;"
    height="70" width="70" class="edit-avatar" data-action="editImage" data-edit="img" />
  </div>
  <div class="center">
    <input type="text" name="name" value="{{document.name}}" class="character-name">
  </div>
  <div class="center">
    <label>{{localize "SYSTEM.Models.Character.FIELDS.hp.label"}}</label>
    <div class="hp-total">
      {{formGroup systemFields.hp.fields.raw value=document.system.hp.raw type="number" max=document.system.hp.max}}
      <p>/</p>
      <div class="form-group slim inline">
        <input type="number" value="{{document.system.hp.max}}" disabled>
      </div>
    </div>
  </div>
</div>